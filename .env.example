# Local TypeSafe access: obtain an API key from your TypeSafe account.
# See https://docs.typesafe.ai/introduction/quickstart
# Export into the command's environment; jev.py does not auto-load .env files.
TYPESAFE_API_KEY=

# GitHub Actions secret — set in repo Settings → Secrets and variables → Actions,
# NOT copied into .env:
#   https://github.com/jbaruch/software-factory/settings/secrets/actions
# FLEET_DISPATCH_TOKEN — the token .github/workflows/review-trigger.yml reads to start the
#   review run in jbaruch/coding-policy. Create it with Actions: Read and write on
#   jbaruch/coding-policy.
FLEET_DISPATCH_TOKEN=
